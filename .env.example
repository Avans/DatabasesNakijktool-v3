# Aiven MySQL connection (copy from the Aiven service overview page)
DB_HOST=mysql-xxxxxxx-yyyyyyy.a.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=databaas

# Contents of the Aiven CA certificate (ca.pem).
# Paste as a single line with \n between the lines, keeping the BEGIN/END markers.
# Leave empty to connect over TLS without verifying the certificate chain.
DB_SSL_CA=

# Location of the v2 sqlinit/ directory with the SQL dumps, used only by
# scripts/load-database.sh. Leave empty when the v2 project is the parent
# directory or a sibling checkout named DatabasesNakijktool-v2; the script
# finds it then by itself.
SQLINIT_DIR=

# Restricted read-only account used for student queries (see README, step 4).
# Falls back to DB_USER/DB_PASSWORD when empty; student queries then still run
# inside a read-only transaction with a timeout.
STUDENT_DB_USER=nakijk_student
STUDENT_DB_PASSWORD=

# Maximum runtime of a single student query, in milliseconds.
STUDENT_QUERY_TIMEOUT_MS=5000

# sql_mode for student queries. Aiven ships ANSI in sql_mode, which makes double
# quotes mean column names and `||` mean concatenation - so ordinary v2 queries
# like `WHERE code = "KLS"` fail. Leave empty to use MySQL's default mode, which
# is what students expect and what the v2 server did.
STUDENT_SQL_MODE=

# Connections per pool. Keep low: Aiven's free plan caps total connections.
DB_CONNECTION_LIMIT=3

# Allowed origins for the browser component. Comma separated, or * for all.
# Brightspace pages are served from your school's domain.
CORS_ORIGIN=*

# Secret used to sign the token handed out for an approved submission.
SECRET_KEY=change-me-to-a-long-random-string

# Set this in Vercel so only Vercel's scheduler can trigger the keep-alive.
CRON_SECRET=change-me-to-a-long-random-string
